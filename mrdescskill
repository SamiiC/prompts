#!/usr/bin/env python3
"""Render a continuously animated phase-navigation stepper (stdlib only).

Example:
  python3 render_continuous_stepper.py assets/example-continuous-stepper.json --out diagram.html
The template has a reusable timeline, evolving process loads, moving request/response
packets, status snapshots, and event history. Customize narrative/event times and
phase labels through the spec. This is a diagram animation, not an execution simulator.
"""
import argparse, json, pathlib, re, html

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument('spec')
    ap.add_argument('--out',required=True)
    a=ap.parse_args()
    spec=json.loads(pathlib.Path(a.spec).read_text())
    template=pathlib.Path(__file__).resolve().parent.parent.joinpath('assets/continuous-stepper-template.html').read_text()
    # Replace textual fields in HTML. Use HTML escape for supplied prose.
    root=spec.get('figure','FIGURE 01 · CONTINUOUS STEPPER')
    for old,new in [
        ('FIGURE 04 · BACKGROUND JOBS · CONTINUOUS STEPPER',root),
        ('One job, multiple processing attempts',spec.get('title','One job, multiple processing attempts')),
        ('A durable work item moves from submission through a failed attempt, retry, and completion.',spec.get('subtitle','A job moves through processing and completion.')),
        ('Job controller',spec.get('card_title','Job controller')),
        ('Job snapshots update throughout the same timeline; requests and worker load evolve continuously.',spec.get('card_note','Snapshots and worker load evolve continuously.')),
    ]:
        template=template.replace(old,html.escape(str(new),quote=True))
    # Edit the phase labels without modifying the static layout / timestamp model.
    for old,p in zip(['SUBMIT JOB','QUEUED WORK','RETRY WORK','COMPLETED'],spec.get('phases',[])):
        template=template.replace(old,html.escape(str(p['label']),quote=True))
    # The four phase timestamps control navigation and active-state highlighting.
    phases=spec.get('phases',[])
    if len(phases)==4:
        for old,p in zip(['0','5','10','16'],phases):
            # Exact token replacement only inside HTML data-time attrs.
            template=template.replace('data-time="'+old+'"','data-time="'+str(p['at'])+'"')
        template=template.replace('const phases=[0,5,10,16];','const phases='+json.dumps([p['at'] for p in phases])+';')
    # Narrative event updates: as time advances, descriptions change independently of phase labels.
    if 'events' in spec:
        events=spec['events']
        if not all(isinstance(e.get('at'),(int,float)) and isinstance(e.get('text'),str) for e in events):
            raise ValueError('Each event needs numeric at and string text')
        payload=json.dumps(sorted(events,key=lambda e:e['at']),ensure_ascii=False).replace('</','<\/')
        template=re.sub(r'const events=\[.*?\];const phases=',lambda m:'const events='+payload+';const phases=',template,count=1,flags=re.S)
    pathlib.Path(a.out).write_text(template,encoding='utf-8')
    print('wrote',a.out)

if __name__=='__main__': main()
