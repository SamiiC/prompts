#!/usr/bin/env python3
"""Render figures in the "engineering blog" style (black card, mono caps label, bold
headline, takeaway, legend, Replay/Pause, thin white outlines, periwinkle fills).

Four figure kinds, chosen with "kind" in the spec JSON:
  flow      request flow between boxes, animated request/response particles
  timeline  Gantt-style lanes over time, animated scrubber, one or more panels
  stepper   tabbed state walkthrough (e.g. LIFO vs FIFO connection pools)
  lanes     stacked comparison panels of pooled/multiplexed connection lanes

Usage:
  render_diagram.py spec.json --out-dir OUT [--name figure-01] [--png] [--scale N]
                    [--freeze-at SECONDS] [--step N] [--keep-buttons]
Outputs OUT/<name>.svg and .html (animated/interactive) and, with --png, a static .png.
Spec format and design rules: references/diagram-style.md
"""
import argparse, html, json, math, os, sys

SANS = "'Soehne','Helvetica Neue',Inter,'Segoe UI',Arial,'DejaVu Sans',sans-serif"
MONO = "'Soehne Mono','JetBrains Mono','SF Mono',Menlo,Consolas,'DejaVu Sans Mono',monospace"
BG, BORDER, RULE, NODE, EDGE, WHITE, DOT = "#000", "#2b2b2b", "#2b2b2b", "#d6d6d6", "#f2f2f2", "#fff", "#3a3a3a"
COL = {"req": "#6f9cf7", "res": "#9be8c6", "cpu": "#8fa9ee", "net": "#5b7bd6", "wait": "#bcd0f5",
       "hl": "#8fb0f5", "ink": "#0b1020"}
KIND_DEFAULTS = {  # width, font scale, side padding
    "flow": (1940, 1.0, 64), "timeline": (1790, 0.9, 64),
    "stepper": (1620, 0.9, 64), "lanes": (1176, 0.62, 50),
}


def esc(s): return html.escape(str(s), quote=True)
def col(c): return COL.get(c, c)


def T(x, y, s, size=20, fam=SANS, w=400, fill=WHITE, anchor="start", ls=None, extra=""):
    ls = f' letter-spacing="{ls}"' if ls is not None else ""
    return (f'<text x="{x:.1f}" y="{y:.1f}" fill="{fill}" font-family="{fam}" font-size="{size:.1f}" '
            f'font-weight="{w}" text-anchor="{anchor}"{ls}{extra}>{esc(s)}</text>')


def MT(x, y, s, size=11, fill=WHITE, anchor="start", extra=""):
    return T(x, y, str(s).upper(), size, MONO, 700, fill, anchor, 0.3, extra)


def rect(x, y, w, h, rx=0, fill="none", stroke=None, sw=1, dash=None, extra=""):
    st = f' stroke="{stroke}" stroke-width="{sw}"' if stroke else ""
    da = f' stroke-dasharray="{dash}"' if dash else ""
    return (f'<rect x="{x:.1f}" y="{y:.1f}" width="{w:.1f}" height="{h:.1f}" rx="{rx}" fill="{fill}"{st}{da}{extra}/>')


def wrap(s, n):
    words, lines, cur = s.split(), [], ""
    for w in words:
        if len(cur) + len(w) + 1 > n and cur:
            lines.append(cur); cur = w
        else:
            cur = (cur + " " + w).strip()
    return lines + ([cur] if cur else [])


# ---------------------------------------------------------------- chrome ---
def legend_icon(shape, color, x, cy, s):
    c = col(color)
    if shape == "square":
        return rect(x, cy - 10.5 * s, 21 * s, 21 * s, 3, c, "#c9d6fb"), 21 * s
    if shape == "ring":
        return f'<circle cx="{x + 10.5 * s:.1f}" cy="{cy:.1f}" r="{9.5 * s:.1f}" fill="{BG}" stroke="{WHITE}" stroke-width="1.2"/>', 21 * s
    if shape == "dash":
        return f'<line x1="{x:.1f}" y1="{cy:.1f}" x2="{x + 26 * s:.1f}" y2="{cy:.1f}" stroke="{WHITE}" stroke-dasharray="3 3"/>', 26 * s
    return f'<circle cx="{x + 10.5 * s:.1f}" cy="{cy:.1f}" r="{10.5 * s:.1f}" fill="{c}" stroke="#d6e2fb"/>', 21 * s


def chrome(spec, W, fs, pad, legend, buttons):
    kind = spec.get("kind", "flow")
    out = []
    label = f"FIGURE {str(spec.get('figure', '01')).upper()}" + (f" \u00b7 {spec['topic'].upper()}" if spec.get("topic") else "")
    out.append(MT(pad, 94 * fs, label, 14 * fs))
    out.append(T(pad, 168 * fs, spec["title"], 31 * fs, SANS, 700, ls=-0.4))
    sub = spec.get("subtitle", "")
    maxc = int((0.75 if kind == "flow" else 0.6) * W / (19 * fs * 0.5))
    for i, ln in enumerate(wrap(sub, maxc)):
        out.append(T(pad, (211 + 31 * i) * fs, ln, 19 * fs))
    ly = 296 * fs
    x = pad
    for it in legend:
        ic, wid = legend_icon(it.get("shape", "square"), it.get("color", "req"), x, ly, fs)
        out.append(ic)
        out.append(T(x + wid + 12 * fs, ly + 7 * fs, it["label"], 20 * fs))
        x += wid + 12 * fs + len(it["label"]) * 10.2 * fs + 36 * fs
    # buttons
    bh, by, right = 51 * fs, 124 * fs, W - 55 * fs
    pw, rw = 117 * fs, 123 * fs
    px = right - pw
    if "pause" in buttons:
        out.append('<g id="pause" style="cursor:pointer">' + rect(px, by, pw, bh, 14 * fs, BG, WHITE)
                   + f'<g id="pause-icon" fill="{WHITE}">{rect(px + 21 * fs, by + 20 * fs, 3.2 * fs, 12 * fs, 0.5)}'
                   f'{rect(px + 27 * fs, by + 20 * fs, 3.2 * fs, 12 * fs, 0.5)}</g>'
                   f'<path id="play-icon" d="M{px + 21 * fs:.1f} {by + 19 * fs:.1f} L{px + 32 * fs:.1f} {by + 26 * fs:.1f} '
                   f'L{px + 21 * fs:.1f} {by + 33 * fs:.1f} Z" fill="{WHITE}" display="none"/>'
                   + T(px + 47 * fs, by + 31 * fs, "Pause", 17 * fs, SANS, 500, extra=' id="pause-label"') + "</g>")
    if "replay" in buttons:
        rx_ = px - 12 * fs - rw
        cx, cy, r = rx_ + 27 * fs, by + bh / 2, 7.5 * fs
        out.append('<g id="replay" style="cursor:pointer">' + rect(rx_, by, rw, bh, 14 * fs, BG, WHITE)
                   + f'<path d="M{cx + r:.1f} {cy - 2 * fs:.1f} A{r:.1f} {r:.1f} 0 1 1 {cx + r * 0.35:.1f} {cy - r * 0.94:.1f}" '
                     f'fill="none" stroke="{WHITE}" stroke-width="1.8" stroke-linecap="round"/>'
                     f'<path d="M{cx + r * 0.35 - 3 * fs:.1f} {cy - r - 3 * fs:.1f} L{cx + r * 0.35 + 1:.1f} {cy - r * 0.94:.1f} '
                     f'L{cx + r * 0.35 - 4 * fs:.1f} {cy - r * 0.94 + 4 * fs:.1f}" fill="none" stroke="{WHITE}" stroke-width="1.8" stroke-linecap="round"/>'
                   + T(rx_ + 49 * fs, by + 31 * fs, "Replay", 17 * fs, SANS, 500) + "</g>")
    rule = (333 if legend else 308) * fs
    return out, rule


# ----------------------------------------------------------------- flow ----
def anchor(n, side):
    x, y, w, h = n["x"], n["y"], n["w"], n["h"]
    return {"r": (x + w, y + h / 2), "l": (x, y + h / 2), "t": (x + w / 2, y), "b": (x + w / 2, y + h)}[side]


def route(a, b, sides, vx=None, vy=None, via=None):
    if via: return [a] + [tuple(p) for p in via] + [b]
    if sides[0] in "lr":
        if abs(a[1] - b[1]) < 0.6: return [a, b]
        v = vx if vx is not None else (a[0] + b[0]) / 2
        return [a, (v, a[1]), (v, b[1]), b]
    if abs(a[0] - b[0]) < 0.6: return [a, b]
    v = vy if vy is not None else (a[1] + b[1]) / 2
    return [a, (a[0], v), (b[0], v), b]


def rpath(pts, r=8):
    c = [pts[0]]
    for p in pts[1:]:
        if abs(p[0] - c[-1][0]) > .01 or abs(p[1] - c[-1][1]) > .01: c.append(p)
    pts = c
    d = f"M{pts[0][0]:.1f},{pts[0][1]:.1f}"
    for i in range(1, len(pts) - 1):
        p0, p1, p2 = pts[i - 1], pts[i], pts[i + 1]
        l1, l2 = math.hypot(p1[0] - p0[0], p1[1] - p0[1]), math.hypot(p2[0] - p1[0], p2[1] - p1[1])
        rr = min(r, l1 / 2, l2 / 2)
        ux, uy, vx, vy = (p1[0] - p0[0]) / l1, (p1[1] - p0[1]) / l1, (p2[0] - p1[0]) / l2, (p2[1] - p1[1]) / l2
        d += f" L{p1[0] - ux * rr:.1f},{p1[1] - uy * rr:.1f} Q{p1[0]:.1f},{p1[1]:.1f} {p1[0] + vx * rr:.1f},{p1[1] + vy * rr:.1f}"
    return d + f" L{pts[-1][0]:.1f},{pts[-1][1]:.1f}"


def particle(kind, href, dur, begin, ring=False, size=1.0):
    """A request square / response dot moving along a path, looping forever."""
    if kind == "req":
        sh, close = (f'<rect x="{-6.5 * size}" y="{-6.5 * size}" width="{13 * size}" height="{13 * size}" rx="2.5" '
                     f'fill="{COL["req"]}" stroke="#c9d6fb">'), "</rect>"
    elif ring:
        sh, close = f'<circle r="{6.5 * size}" fill="{BG}" stroke="{WHITE}" stroke-width="1.2">', "</circle>"
    else:
        sh, close = f'<circle r="{6.5 * size}" fill="{COL["res"]}" stroke="#c5f3df">', "</circle>"
    return (sh + f'<animateMotion dur="{dur:.2f}s" begin="{begin:.2f}s" repeatCount="indefinite" rotate="0">'
            f'<mpath xlink:href="{href}"/></animateMotion>' + close)


def body_flow(spec, W, R):
    H = spec.get("height", 920)
    nodes = {n["id"]: n for n in spec.get("nodes", [])}
    edges = spec.get("edges", [])
    steps = sorted({e.get("step", 1) for e in edges if e.get("particles", True)}) or [1]
    n = max(steps); seg = 1.1; win = seg * 2.8; Tt = 2 * n * seg + win + 1.0
    out = [f'<rect x="16" y="{R:.1f}" width="{W - 32}" height="{H - 16 - R:.1f}" fill="url(#dots)"/>']
    for g in spec.get("groups", []):
        out.append(rect(g["x"] + .5, g["y"] + .5, g["w"], g["h"], 2, BG, NODE))
    for lb in spec.get("labels", []):
        out.append(MT(lb["x"], lb["y"], lb["text"], 13, anchor="middle"))
    defs, parts = [], []
    for i, e in enumerate(edges):
        fs_, ts_ = e.get("fromSide", "r"), e.get("toSide", "l")
        a, b = anchor(nodes[e["from"]], fs_), anchor(nodes[e["to"]], ts_)
        if "fromY" in e: a = (a[0], e["fromY"])
        if "toY" in e: b = (b[0], e["toY"])
        pts = route(a, b, (fs_, ts_), e.get("viaX"), e.get("viaY"), e.get("via"))
        ar = e.get("arrows", "both")
        ms = ' marker-start="url(#chev)"' if ar in ("both", "start") else ""
        me = ' marker-end="url(#chev)"' if ar in ("both", "end") else ""
        out.append(f'<path id="e{i}" d="{rpath(pts)}" fill="none" stroke="{EDGE}" stroke-width="1"{ms}{me}/>')
        defs.append(f'<path id="e{i}r" d="{rpath(list(reversed(pts)))}"/>')
        if e.get("particles", True):
            k = e.get("step", 1)
            for kind, t0 in (("req", (k - 1) * seg), ("res", (2 * n - k) * seg)):
                a_, b_ = t0 / Tt, min((t0 + win) / Tt, 1.0)
                ep = 0.12 * win / Tt
                sh = (f'<rect x="-6.5" y="-6.5" width="13" height="13" rx="2.5" fill="{COL["req"]}" stroke="#c9d6fb" opacity="0">'
                      if kind == "req" else f'<circle r="6.5" fill="{COL["res"]}" stroke="#c5f3df" opacity="0">')
                close = "</rect>" if kind == "req" else "</circle>"
                parts.append(sh + f'<animateMotion dur="{Tt:.2f}s" repeatCount="indefinite" calcMode="linear" keyPoints="0;0;1;1" '
                             f'keyTimes="0;{a_:.4f};{b_:.4f};1" rotate="0"><mpath xlink:href="#{"e%d" % i if kind == "req" else "e%dr" % i}"/></animateMotion>'
                             f'<animate attributeName="opacity" dur="{Tt:.2f}s" repeatCount="indefinite" values="0;0;1;1;0;0" '
                             f'keyTimes="0;{a_:.4f};{min(a_ + ep, b_):.4f};{max(b_ - ep, a_):.4f};{b_:.4f};1"/>' + close)
    out.append("<defs>" + "".join(defs) + "</defs>")
    for nd in spec.get("nodes", []):
        x, y, w, h = nd["x"], nd["y"], nd["w"], nd["h"]
        out.append(rect(x + .5, y + .5, w, h, 3, BG, NODE))
        if nd.get("sub"):
            out.append(T(x + 19, y + h / 2 - 1, nd["label"], 20))
            out.append(MT(x + 19, y + h / 2 + 20, nd["sub"], 13))
        else:
            out.append(T(x + 19, y + h / 2 + 7, nd["label"], 20))
    out += parts
    return out, H, {"T": Tt, "freeze": n * seg * 0.95}


# ------------------------------------------------------------- timeline ----
def body_timeline(spec, W, R, pad):
    ax = spec.get("axis", {"max": 40, "ticks": [0, 10, 20, 30, 40]})
    tmax = ax["max"]; X0, X1 = pad + 186, W - pad; px = (X1 - X0) / tmax
    play = tmax * 0.3; Tt = play + 1.6
    out, y, cid = [], R, 0

    def reveal(t0, t1):
        a, b = t0 / tmax * play / Tt, t1 / tmax * play / Tt
        return a, b

    def track(ty, label_y, segs):
        nonlocal cid
        cid += 1
        o = [f'<clipPath id="tc{cid}">{rect(X0 + .5, ty + .5, X1 - X0, 44, 22)}</clipPath><g clip-path="url(#tc{cid})">']
        if segs and segs[0]["t"] > 0:
            o.append(f'<line x1="{X0 + 12}" y1="{ty + 22}" x2="{X0 + segs[0]["t"] * px:.1f}" y2="{ty + 22}" stroke="#777" stroke-dasharray="1 3"/>')
        for s in segs:
            x, w = X0 + s["t"] * px, s["d"] * px
            k = s.get("kind", "cpu")
            fill = {"cpu": COL["cpu"], "net": COL["net"], "wait": COL["wait"]}.get(k, BG)
            dash = "2 2" if k in ("wait", "blocked") else None
            stroke = WHITE if k in ("wait", "blocked") else ("#9a9a9a" if k == "plain" else "#000")
            a, b = reveal(s["t"], s["t"] + s["d"])
            anim = (f'<animate attributeName="width" dur="{Tt:.2f}s" repeatCount="indefinite" calcMode="linear" '
                    f'values="0;0;{w:.1f};{w:.1f}" keyTimes="0;{a:.4f};{b:.4f};1"/>') if k in ("cpu", "net", "wait") else ""
            o.append(f'<rect x="{x:.1f}" y="{ty + 1}" width="{w:.1f}" height="42" fill="{fill}" stroke="{stroke}" '
                     f'stroke-width="{1 if dash else 1.2}"{" stroke-dasharray=%s" % chr(34) + dash + chr(34) if dash else ""}>{anim}</rect>')
            if s.get("text") and w > len(s["text"]) * 8 + 8:
                tc = COL["ink"] if k in ("cpu", "wait") else WHITE
                o.append(MT(x + w / 2, ty + 26, s["text"], 11, tc, "middle"))
        o.append("</g>" + rect(X0 + .5, ty + .5, X1 - X0, 44, 22, "none", WHITE))
        return "".join(o)

    for pi, p in enumerate(spec["panels"]):
        py = y
        if pi > 0: out.append(f'<line x1="{pad}" y1="{py:.1f}" x2="{W - pad}" y2="{py:.1f}" stroke="{RULE}"/>')
        out.append(T(pad, py + 46, p["title"], 23, SANS, 600, ls=-0.2))
        if p.get("note"): out.append(T(W - pad, py + 46, p["note"], 18, anchor="end"))
        if p.get("status"): out.append(T(pad, py + 91, p["status"], 18))
        out.append(MT(pad, py + 152, ax.get("label", "Time \u2192"), 11))
        for tk in ax["ticks"]:
            out.append(MT(X0 + tk * px, py + 152, tk, 11, anchor="end" if tk == tmax else "start"))
        thr = p["thread"]
        out.append(T(pad, py + 176 + 29, thr.get("label", "Python thread"), 20, SANS, 500))
        out.append(track(py + 176, 0, thr["segments"]))
        out.append(f'<line x1="{pad}" y1="{py + 240}" x2="{W - pad}" y2="{py + 240}" stroke="{RULE}"/>')
        ly = py + 276
        for ln in p["lanes"]:
            out.append(T(pad, ly + 16, ln["label"], 20, SANS, 500))
            for j, sl in enumerate(wrap(ln.get("sub", "").upper(), 20)[:2]):
                out.append(MT(pad, ly + 36 + j * 17, sl, 11))
            out.append(track(ly, 0, ln["segments"]))
            if "marker" in ln:
                mx = X0 + ln["marker"] * px
                out.append(f'<line x1="{mx:.1f}" y1="{ly - 2}" x2="{mx:.1f}" y2="{ly + 46}" stroke="{WHITE}" stroke-width="2"/>'
                           f'<polygon points="{mx:.1f},{ly - 10} {mx + 5:.1f},{ly - 5} {mx:.1f},{ly} {mx - 5:.1f},{ly - 5}" fill="{WHITE}"/>')
            ly += 87
        out.append(f'<line x1="{X0}" y1="{py + 166}" x2="{X0}" y2="{ly - 40}" stroke="#4a6fd0" stroke-width="1">'
                   f'<animate attributeName="x1" dur="{Tt:.2f}s" repeatCount="indefinite" values="{X0};{X1};{X1}" keyTimes="0;{play / Tt:.4f};1"/>'
                   f'<animate attributeName="x2" dur="{Tt:.2f}s" repeatCount="indefinite" values="{X0};{X1};{X1}" keyTimes="0;{play / Tt:.4f};1"/></line>')
        if p.get("footer"): out.append(T(X0, ly - 87 + 108, p["footer"], 19))
        y = ly - 87 + 108 + 62
    return out, y, {"T": Tt, "freeze": play * 0.46}


# -------------------------------------------------------------- stepper ----
def body_stepper(spec, W, R, pad, active, interactive):
    steps = spec["steps"]
    card = spec.get("card", {})
    out = []
    cw = min(1097, W - 2 * pad); cx = (W - cw) / 2
    tabw = (W - 2 * pad) / len(steps)
    out.append(f'<line x1="16" y1="{R + 93}" x2="{W - 16}" y2="{R + 93}" stroke="{RULE}"/>')
    out.append(f'<line x1="16" y1="{R + 191}" x2="{W - 16}" y2="{R + 191}" stroke="{RULE}"/>')
    out.append(f'<line x1="{pad}" y1="{R + 190}" x2="{W - pad}" y2="{R + 190}" stroke="#2f2f2f" stroke-width="3"/>')
    for i, st in enumerate(steps):
        tx = pad + i * tabw
        out.append(f'<g id="tab-{i}" style="cursor:pointer">' + rect(tx, R + 93, tabw, 98, 0, "transparent")
                   + MT(tx, R + 146, f"{i + 1:02d}  {st['tab']}", 11.5) + "</g>")
        out.append(f'<line id="ul-{i}" x1="{tx:.1f}" y1="{R + 190}" x2="{tx + 171:.1f}" y2="{R + 190}" stroke="{COL["hl"]}" '
                   f'stroke-width="3" display="{"inline" if i == active else "none"}"/>')
    cy = R + 228
    for i, st in enumerate(steps):
        g = [f'<g id="step-{i}" display="{"inline" if i == active else "none"}">']
        g.append(T(W / 2, R + 54, st.get("caption", ""), 19 * 0.95, anchor="middle") if False else T(pad, R + 54, st.get("caption", ""), 18.5))
        g.append(rect(cx + .5, cy + .5, cw, 800, 14, BG, "#333"))
        g.append(T(cx + 20, cy + 43, st.get("title", card.get("title", "")), 22, SANS, 600))
        g.append(T(cx + 20, cy + 80, st.get("note", card.get("note", "")), 16.5))
        pool = st.get("pool", {})
        g.append(MT(cx + 20, cy + 117, pool.get("first", "Returned first"), 11))
        g.append(MT(cx + cw - 20, cy + 117, pool.get("last", "Returned last"), 11, anchor="end"))
        n = pool.get("slots", 9); inner = cw - 40; gap = 5
        pw_ = (inner - (n - 1) * gap) / n
        for j in range(n):
            x = cx + 20 + j * (pw_ + gap)
            it = pool["filled"][j] if j < len(pool.get("filled", [])) else None
            if it:
                hl = it.get("hl")
                g.append(rect(x + .5, cy + 135.5, pw_, 38, 19, BG, COL["hl"] if hl else NODE))
                g.append(MT(x + pw_ / 2 + .5, cy + 159, it["text"], 11, anchor="middle"))
            else:
                g.append(rect(x + .5, cy + 135.5, pw_, 38, 19, "none", "#bbb", dash="3 3"))
        g.append(MT(cx + cw / 2, cy + 209, pool.get("status", ""), 11, anchor="middle"))
        g.append(f'<line x1="{cx + .5}" y1="{cy + 230}" x2="{cx + cw - .5}" y2="{cy + 230}" stroke="#333"/>')
        sv = st["servers"]; m = len(sv); sgap = 14; scw = (inner - (m - 1) * sgap) / m
        top = cy + 342
        for j, s in enumerate(sv):
            sx = cx + 20 + j * (scw + sgap)
            ar = s.get("arrows", {"down": True, "up": True})
            dcol = COL["hl"] if ar.get("hl") == "down" else NODE
            ucol = COL["hl"] if ar.get("hl") == "up" else NODE
            dx, ux = sx + scw * 0.458, sx + scw * 0.545
            if ar.get("down", True):
                g.append(f'<path class="traffic-path" d="M{dx:.1f} {cy + 230} L{dx:.1f} {top}" stroke="{dcol}" fill="none" marker-end="url(#chev)"/>')
                g.append(f'<circle r="5" fill="{COL["hl"]}" class="packet" opacity="0"><animateMotion dur="1.65s" begin="{j * .22:.2f}s" repeatCount="indefinite" path="M{dx:.1f} {cy + 230} L{dx:.1f} {top}"/><animate attributeName="opacity" values="0;1;1;0" keyTimes="0;.15;.85;1" dur="1.65s" repeatCount="indefinite"/></circle>')
            if ar.get("up", True):
                g.append(f'<path class="traffic-path" d="M{ux:.1f} {top} L{ux:.1f} {cy + 230}" stroke="{ucol}" fill="none" marker-end="url(#chev)"/>')
                g.append(f'<circle r="4" fill="{COL["res"]}" opacity="0"><animateMotion dur="2.1s" begin="{.75 + j * .28:.2f}s" repeatCount="indefinite" path="M{ux:.1f} {top} L{ux:.1f} {cy + 230}"/><animate attributeName="opacity" values="0;1;1;0" keyTimes="0;.15;.85;1" dur="2.1s" repeatCount="indefinite"/></circle>')
            if ar.get("ring"):
                g.append(f'<circle cx="{ux:.1f}" cy="{cy + 262}" r="5" fill="{BG}" stroke="{ucol}"/>')
            g.append(rect(sx + .5, top + .5, scw, 294, 12, BG, NODE))
            g.append(MT(sx + scw / 2, top + 29, "Server process", 11, anchor="middle"))
            g.append(T(sx + scw / 2, top + 62, s["name"], 20, SANS, 700, anchor="middle"))
            off = 0
            if s.get("banner"):
                g.append(rect(sx + 12, top + 78, scw - 23, 38, 2, COL["cpu"]))
                g.append(MT(sx + scw / 2, top + 101, s["banner"], 11, COL["ink"], "middle"))
                off = 50
            g.append(T(sx + scw / 2, top + 86 + off, s.get("count", 0), 17, anchor="middle"))
            g.append(MT(sx + scw / 2, top + 110 + off, "Concurrent requests", 11, anchor="middle"))
            sl = s.get("slots", 3); rq = s.get("reqs", s.get("count", 0))
            for k in range(sl):
                yy = top + 148 + off + k * 31
                if k >= sl - rq:
                    last = k == sl - 1
                    g.append(rect(sx + 12.5, yy + .5, scw - 25, 25, 2, COL["cpu"] if last else COL["wait"]))
                    g.append(MT(sx + scw / 2, yy + 17, "Request", 11, COL["ink"], "middle"))
                else:
                    g.append(rect(sx + 12.5, yy + .5, scw - 25, 25, 2, "none", "#bbb", dash="3 3"))
        g.append(f'<line x1="{cx + .5}" y1="{cy + 664}" x2="{cx + cw - .5}" y2="{cy + 664}" stroke="#333"/>')
        q = st.get("queue", {"total": 18, "filled": 0})
        g.append(MT(cx + 20, cy + 692, "Subsequent requests", 11))
        qw = (inner - (q["total"] - 1) * 5) / q["total"]
        for k in range(q["total"]):
            qx = cx + 20 + k * (qw + 5)
            if k < q.get("filled", 0):
                g.append(rect(qx + .5, cy + 708.5, qw, 25, 2, COL["wait"]))
            else:
                g.append(rect(qx + .5, cy + 708.5, qw, 25, 2, "none", "#bbb", dash="3 3"))
        g.append("</g>")
        out += g
    return out, cy + 800 + 40, {"T": len(steps) * 3.2, "freeze": 0, "steps": len(steps)}


# ---------------------------------------------------------------- lanes ----
def body_lanes(spec, W, R, pad):
    ring = spec.get("response_style", "ring") == "ring"
    out, defs, y = [], [], R
    uid = 0
    for pi, p in enumerate(spec["panels"]):
        py = y + (26 if pi == 0 else 18)
        if pi > 0: out.append(f'<line x1="{pad}" y1="{y:.1f}" x2="{W - pad}" y2="{y:.1f}" stroke="{RULE}"/>')
        out.append(T(pad, py + 20, p["title"], 16, SANS, 600))
        out.append(T(pad, py + 44, p.get("desc", ""), 12.5))
        for hd in p.get("headers", []):
            out.append(MT(hd["x"], py + 76, hd["text"], 8.7, anchor="middle"))
        rows = p["rows"]; top = py + 92; rowh = 40
        bh = len(rows) * rowh - 6
        mode = p.get("mode", "direct")
        sx0, sw_ = 967, 160
        out.append(rect(sx0 + .5, top - 3 + .5, sw_, bh + 6, 9, BG, WHITE))
        for k, ln in enumerate(wrap(p.get("storage", "Azure Cosmos DB"), 12)):
            out.append(T(sx0 + sw_ / 2, top + bh / 2 + (k - (len(wrap(p.get("storage", "Azure Cosmos DB"), 12)) - 1) / 2) * 20 + 5, ln, 15.5, SANS, 600, anchor="middle"))
        mid = p.get("mid")
        mx0, mw = 477, 132
        if mid:
            out.append(rect(mx0 + .5, top - 3 + .5, mw, bh + 6, 9, BG, WHITE))
            out.append(T(mx0 + mw / 2, top + bh / 2 + 2, mid["label"], 15.5, SANS, 600, anchor="middle"))
            out.append(MT(mx0 + mw / 2, top + bh / 2 + 22, mid.get("sub", ""), 8.7, anchor="middle"))
        beat = 0
        for i, r in enumerate(rows):
            cy = top + i * rowh + 17
            out.append(rect(140.5, cy - 17 + .5, 125, 34, 3, BG, NODE))
            out.append(MT(203, cy - 3, r["label"], 8.7, anchor="middle"))
            out.append(MT(203, cy + 10, r.get("sub", ""), 8.7, anchor="middle"))
            # lead-in
            uid += 1
            inc = r.get("incoming", False)
            out.append(f'<path id="L{uid}" d="M{pad} {cy} L140 {cy}" stroke="{EDGE if inc else "#777"}" '
                       f'stroke-dasharray="{"" if inc else "1 3"}" fill="none"/>')
            if inc: out.append(particle("req", f"#L{uid}", 3.0, -(beat % 3), ring)); beat += 1.1
            busy = r.get("active", 0) > 0
            if mid:
                uid += 1
                out.append(f'<path id="L{uid}" d="M265.5 {cy} L{mx0} {cy}" stroke="{EDGE}" '
                           f'stroke-dasharray="{"" if busy else "3 3"}" fill="none"/>')
                defs.append(f'<path id="L{uid}r" d="M{mx0} {cy} L265.5 {cy}"/>')
                if busy:
                    out.append(particle("req", f"#L{uid}", 3.0, -(beat % 3), ring)); beat += 1.3
                    out.append(particle("res", f"#L{uid}r", 3.0, -(beat % 3), ring)); beat += 0.9
            elif mode == "direct":
                peak, act = r.get("peak", 3), r.get("active", 0)
                for j in range(peak):
                    ly_ = cy - (peak - 1) * 6.5 + j * 13
                    uid += 1
                    isb = j < act
                    out.append(f'<path id="L{uid}" d="M265.5 {ly_:.1f} L{sx0} {ly_:.1f}" stroke="{EDGE}" '
                               f'stroke-dasharray="{"" if isb else "3 3"}" fill="none"/>')
                    defs.append(f'<path id="L{uid}r" d="M{sx0} {ly_:.1f} L265.5 {ly_:.1f}"/>')
                    if isb:
                        out.append(particle("req" if j % 2 == 0 else "res", f"#L{uid}" if j % 2 == 0 else f"#L{uid}r", 3.4, -(beat % 3.4), ring)); beat += 1.1
        # mid -> storage
        if mid:
            if mode == "pooled":
                for i in range(p.get("open", len(rows))):
                    cy = top + i * rowh + 17
                    uid += 1
                    out.append(f'<path id="L{uid}" d="M{mx0 + mw} {cy} L{sx0} {cy}" stroke="{EDGE}" fill="none"/>')
                    defs.append(f'<path id="L{uid}r" d="M{sx0} {cy} L{mx0 + mw} {cy}"/>')
                    out.append(particle("req" if i % 2 == 0 else "res", f"#L{uid}" if i % 2 == 0 else f"#L{uid}r", 3.2, -(beat % 3.2), ring)); beat += 1.0
            else:
                cy = top + bh / 2
                uid += 1
                out.append(f'<path id="L{uid}" d="M{mx0 + mw} {cy} L{sx0} {cy}" stroke="{EDGE}" fill="none"/>')
                defs.append(f'<path id="L{uid}r" d="M{sx0} {cy} L{mx0 + mw} {cy}"/>')
                for k in range(p.get("streams", 6)):
                    out.append(particle("req" if k % 2 == 0 else "res", f"#L{uid}" if k % 2 == 0 else f"#L{uid}r", 3.0, -(k * 0.5), ring))
        if p.get("footer"): out.append(T(pad, top + bh + 36, p["footer"], 12.5))
        y = top + bh + 36 + 28
    out.append("<defs>" + "".join(defs) + "</defs>")
    return out, y + 10, {"T": 3.2, "freeze": 1.1}


