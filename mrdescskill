def render_png(html_path, png_path, W, H, scale, freeze):
    from playwright.sync_api import sync_playwright
    with sync_playwright() as p:
        import shutil
        browser_path = shutil.which("chromium") or shutil.which("google-chrome")
        try:
            b = p.chromium.launch()
        except Exception:
            if not browser_path:
                raise
