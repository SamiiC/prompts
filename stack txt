def main():
    parser = argparse.ArgumentParser(description='Extract and optionally install local-only pstack skills')
    parser.add_argument('--output', default='pstack-work-local', help='Extraction folder')
    parser.add_argument('--install-claude', action='store_true', help='Install Claude skills and agents')
    parser.add_argument('--install-codex', action='store_true', help='Install Codex skills')
    parser.add_argument('--project-dir', help='Use project-local install directories instead of user home')
    args = parser.parse_args()
    root = pathlib.Path(args.output).expanduser().resolve()
    bundle = json.loads(zlib.decompress(base64.b85decode(DATA)).decode())
    if bundle['format'] != 'pstack-work-skills-v1' or bundle['count'] != len(bundle['files']):
        raise ValueError('Bad bundle header or file index')
    verified={}
    for name, entry in bundle['files'].items():
        path = pathlib.PurePosixPath(name)
        if path.is_absolute() or '..' in path.parts or '\\' in name:
            raise ValueError('Unsafe file path: '+name)
        target=(root/name).resolve()
        if not target.is_relative_to(root):
            raise ValueError('Unsafe target: '+name)
        contents=base64.b64decode(entry['data'],validate=True)
        if hashlib.sha256(contents).hexdigest()!=entry['sha256']:
            raise ValueError('SHA256 mismatch: '+name)
        if target.exists() and target.read_bytes()!=contents:
            raise FileExistsError('Changed extraction target: '+str(target))
        verified[target]=contents
    for target, data in verified.items():
        target.parent.mkdir(parents=True,exist_ok=True)
        target.write_bytes(data)
    print('Extracted and verified',len(verified),'files to',root)
    if args.project_dir:
        home = pathlib.Path(args.project_dir).expanduser().resolve()
    else:
        home = pathlib.Path.home()
    jobs=[]
    if args.install_claude:
        jobs += [(root/'skills',home/'.claude'/'skills'),(root/'agents',home/'.claude'/'agents')]
    if args.install_codex:
        jobs += [(root/'skills',home/'.agents'/'skills')]
    for src,dst in jobs:
        dst.mkdir(parents=True,exist_ok=True)
        created=skipped=0
        for item in src.iterdir():
            target=dst/item.name
            if target.exists() or target.is_symlink():
                print('Skipping existing:',target)
                skipped+=1
                continue
            if item.is_dir(): shutil.copytree(item,target)
            else: shutil.copy2(item,target)
            created+=1
        print(f'Installed {created} items, skipped {skipped}: {dst}')
    print('Read', root/'OFFLINE_INSTALL.md', 'for manual setup details')

if __name__ == '__main__':
    main()