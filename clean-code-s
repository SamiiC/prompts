## VALUE OBJECTS / DTOs / RECORDS

Prefer Java records for immutable data transfer. When you need more control, use the Guava builder pattern.

```java
// For simple DTOs: Java record (Java 16+)
/**
 * Request body for user creation.
 *
 * @param name the display name; must not be blank
 * @param email the email address; must be a valid email
 */
public record CreateUserRequest(
    @NotBlank @Size(max = 100) String name,
    @NotBlank @Email String email) {}
```

```java
// For richer objects needing validation on construction: Guava builder pattern
/**
 * An immutable representation of a user as returned by the API.
 *
 * <p>Use {@link #builder()} to create instances.
 */
public final class UserResponse {

  private final long id;
  private final String name;
  private final String email;
  private final Instant createdAt;

  private UserResponse(Builder builder) {
    this.id = builder.id;
    this.name = checkNotNull(builder.name, "name");
    this.email = checkNotNull(builder.email, "email");
    this.createdAt = checkNotNull(builder.createdAt, "createdAt");
  }

  /** Returns a new builder for {@link UserResponse}. */
  public static Builder builder() {
    return new Builder();
  }

  /** Creates a {@link UserResponse} from the domain {@link User} object. */
  public static UserResponse from(User user) {
    checkNotNull(user, "user");
    return builder()
        .id(user.getId())
        .name(user.getName())
        .email(user.getEmail())
        .createdAt(user.getCreatedAt())
        .build();
  }

  public long id() { return id; }
  public String name() { return name; }
  public String email() { return email; }
  public Instant createdAt() { return createdAt; }

  /** Builder for {@link UserResponse}. */
  public static final class Builder {
    private long id;
    private @Nullable String name;
    private @Nullable String email;
    private @Nullable Instant createdAt;

    private Builder() {}

    @CanIgnoreReturnValue
    public Builder id(long id) {
      checkArgument(id > 0, "id must be positive: %s", id);
      this.id = id;
      return this;
    }

    @CanIgnoreReturnValue
    public Builder name(String name) {
      this.name = checkNotNull(name, "name");
      return this;
    }

    @CanIgnoreReturnValue
    public Builder email(String email) {
      this.email = checkNotNull(email, "email");
      return this;
    }

    @CanIgnoreReturnValue
    public Builder createdAt(Instant createdAt) {
      this.createdAt = checkNotNull(createdAt, "createdAt");
      return this;
    }

    public UserResponse build() {
      return new UserResponse(this);
    }
  }
}
```

